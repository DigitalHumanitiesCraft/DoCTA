# Synthetic negative fixture: Transaction without Transfer.
@prefix bk: <https://gams.uni-graz.at/o:depcha.bookkeeping#> .
@prefix docta: <https://dhcraft.org/DoCTA/ns#> .
@prefix ex: <https://dhcraft.org/DoCTA/id/fixture/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

ex:anchor-1 a docta:SourceAnchor .
ex:entry-1 a bk:Entry ; prov:wasDerivedFrom ex:anchor-1 .
ex:transaction-1 a bk:Transaction ;
    bk:entry ex:entry-1 ;
    prov:wasDerivedFrom ex:anchor-1 .

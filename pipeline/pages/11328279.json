       "id": "r3l2",
       "text": "fuederle mit zwain rossen gefuĕrt"
      },
      {
       "id": "r3l3",
       "text": "werden, und etlich stro pro"
      },
      {
       "id": "r3l4",
       "text": "XXIIII gld."
      },
      {
       "id": "r3l5",
       "text": "XXXIIII stăr koren und 1/2 stăr ist"
      },
      {
       "id": "r3l6",
       "text": "darein gelassen, ain star pro I lb.,"
      },
      {
       "id": "r3l7",
       "text": "facit"
      },
      {
       "id": "r3l8",
       "text": "III mr̃. IIII lb."
      },
      {
       "id": "r3l9",
       "text": "XLVI stăr gersten, I stăr pro X k.,"
      },
      {
       "id": "r3l10",
       "text": "facit"
      },
      {
       "id": "r3l11",
       "text": "III mr̃. VIII lb. IIII k."
      },
      {
       "id": "r3l12",
       "text": "Zwo groß swăbisch kandeln."
      },
      {
       "id": "r3l13",
       "text": "Ain zwo måssige kandel, drey maß"
      },
      {
       "id": "r3l14",
       "text": "kandl, ain trinckn kandel, drey"
      },
      {
       "id": "r3l15",
       "text": "zynein schŭseln, ain saltzfas, ain"
      },
      {
       "id": "r3l16",
       "text": "gyesfas. Ist alles geschătzt pro"
      },
      {
       "id": "r3l17",
       "text": "X lb."
      },
      {
       "id": "r3l18",
       "text": "VII pfannen klein und groß"
      },
      {
       "id": "r3l19",
       "text": "und ain pfefferpfannen pro"
      },
      {
       "id": "r3l20",
       "text": "III lb."
      },
      {

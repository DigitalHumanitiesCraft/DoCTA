  <text xml:lang="gmh">
    <body>
      <div type="transcription">
        <pb n="1" facs="#surface-11329460-1"/>
        <ab xml:id="ab-11329460-1-r1">
          <milestone unit="folio" n="1r"/>
        </ab>
        <ab xml:id="ab-11329460-1-r2">
          <lb facs="#zone-11329460-1-r2l1"/>Nota haw̆srat was dem
          <lb facs="#zone-11329460-1-r2l2"/>Frechen im hauß beleibt und daz
          <lb facs="#zone-11329460-1-r2l3"/>wid(er) darumb widerumb der Frech antwurt(e)n sol
          <lb facs="#zone-11329460-1-r2l4"/>und dalassen soll. Beschechen am phincz
          <lb facs="#zone-11329460-1-r2l5"/>d(er) Zwelff Potenschidung anno D(o)m(ini) etc. LXIIo.
        </ab>
        <ab xml:id="ab-11329460-1-r3">
          <lb facs="#zone-11329460-1-r3l1"/>It(em) XXVII petstett(e)n und span pet hulczein.
          <lb facs="#zone-11329460-1-r3l2"/>It(em) X tisch.
          <lb facs="#zone-11329460-1-r3l3"/>It(em) und XII fũr penkh.
          <lb facs="#zone-11329460-1-r3l4"/>It(em) II eysein schaufflen.
          <lb facs="#zone-11329460-1-r3l5"/>It(em) I eysn schlegl.
          <lb facs="#zone-11329460-1-r3l6"/>It(em) III eysn stek(e)n.
          <lb facs="#zone-11329460-1-r3l7"/>It(em) II pikel.
          <lb facs="#zone-11329460-1-r3l8"/>It(em) I grossen ingemawrt(e)n kessel.
          <lb facs="#zone-11329460-1-r3l9"/>It(em) I eysnein ofen plech.
          <lb facs="#zone-11329460-1-r3l10"/>It(em) I morser und ain eisnein stõssl.
          <lb facs="#zone-11329460-1-r3l11"/>It(em) IIII bar schnee raiff.
          <lb facs="#zone-11329460-1-r3l12"/>It(em) II visch gern.
          <lb facs="#zone-11329460-1-r3l13"/>It(em) II jag scháfft.
          <lb facs="#zone-11329460-1-r3l14"/>It(em) I har hăchl.
          <lb facs="#zone-11329460-1-r3l15"/>It(em) I vass mit hepf wein pei XII ũrn
          <lb facs="#zone-11329460-1-r3l16"/>ungevarlich.
          <lb facs="#zone-11329460-1-r3l17"/>It(em) I vássl mit essich im zergad(e)n und
          <lb facs="#zone-11329460-1-r3l18"/>vássl in der undern stub(e)n ist ungevarlich
          <lb facs="#zone-11329460-1-r3l19"/>bey I1/2 ũrn.
          <lb facs="#zone-11329460-1-r3l20"/>It(em) I beschlagens ster maß.
          <lb facs="#zone-11329460-1-r3l21"/>It(em) etlich prent(e)n kraút.
          <lb facs="#zone-11329460-1-r3l22"/>It(em) III schef auf dem see zu Sigmu(n)dsp(ur)g
          <lb facs="#zone-11329460-1-r3l23"/>purg.
          <lb facs="#zone-11329460-1-r3l24"/>It(em) I kupfrins gelŏcherts kraut pekh.
          <lb facs="#zone-11329460-1-r3l25"/>It(em) habern zu verfuedern LVI streÿmas.
        </ab>
        <pb n="2" facs="#surface-11329460-2"/>
        <ab xml:id="ab-11329460-2-r1">
          <milestone unit="folio" n="1v"/>
        </ab>
        <ab xml:id="ab-11329460-2-r2">
          <lb facs="#zone-11329460-2-r2l1"/>It(em) kappaw̃n XXXIIII.

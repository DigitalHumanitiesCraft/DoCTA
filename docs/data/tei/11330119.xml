  <text xml:lang="gmh">
    <body>
      <div type="transcription">
        <pb n="1" facs="#surface-11330119-1"/>
        <ab xml:id="ab-11330119-1-r1">
          <milestone unit="folio" n="1r"/>
        </ab>
        <ab xml:id="ab-11330119-1-r2">
          <lb facs="#zone-11330119-1-r2l1"/>Vermergkht was Antoni Schengkh
          <lb facs="#zone-11330119-1-r2l2"/>in dem Schloß Wisberg gefunden
          <lb facs="#zone-11330119-1-r2l3"/>hat, im durch Hannsen Keren gerhab
          <lb facs="#zone-11330119-1-r2l4"/>weiland Hansen Wisers verlasner
          <lb facs="#zone-11330119-1-r2l5"/>kinder und Florian Paldaũff als
          <lb facs="#zone-11330119-1-r2l6"/>nachster frew̃nt der selben kinder
          <lb facs="#zone-11330119-1-r2l7"/>und als beistand geantwũrt ist.
        </ab>
        <ab xml:id="ab-11330119-1-r3">
          <lb facs="#zone-11330119-1-r3l1"/>Item zwoe laglen mit pulver y̆ede nũr halb.
          <lb facs="#zone-11330119-1-r3l2"/>Item etlich kũgell mit pũlver.
          <lb facs="#zone-11330119-1-r3l3"/>Item zway̆ klaine săgkhel mit salitter.
          <lb facs="#zone-11330119-1-r3l4"/>Item schwebel in ainem sagkh.
          <lb facs="#zone-11330119-1-r3l5"/>Item ain hafen vol pũlver.
          <lb facs="#zone-11330119-1-r3l6"/>Item ain kũbell mit ey̆senschroten.
          <lb facs="#zone-11330119-1-r3l7"/>Item ain wenig salitter in ainer lagel.
          <lb facs="#zone-11330119-1-r3l8"/>Item in ainem karnier ain wenig pũxenpulver.
          <lb facs="#zone-11330119-1-r3l9"/>Item zechen feŭrkũgell.
          <lb facs="#zone-11330119-1-r3l10"/>Item in ainer lagell etlich kũgell.
          <lb facs="#zone-11330119-1-r3l11"/>Item in ainem sagkh ist lidrein etlich
          <lb facs="#zone-11330119-1-r3l12"/>kŭgell.
          <lb facs="#zone-11330119-1-r3l13"/>Item anderhalb pleiplaten.
          <lb facs="#zone-11330119-1-r3l14"/>Item zwoe kũpffrine stainpũxen.
          <lb facs="#zone-11330119-1-r3l15"/>Item drey̆ eisen stainpũxen mit irem
          <lb facs="#zone-11330119-1-r3l16"/>gerũst.
          <lb facs="#zone-11330119-1-r3l17"/>Item drey̆ eisen alt klotzpũxen.
          <lb facs="#zone-11330119-1-r3l18"/>Item vier lagel mit pheilen.
          <lb facs="#zone-11330119-1-r3l19"/>Item new̃n alte bõse armbrũst an senden.
          <lb facs="#zone-11330119-1-r3l20"/>Item drey̆ eben.
          <lb facs="#zone-11330119-1-r3l21"/>Item im Schnegklen ain grosser haũff
          <lb facs="#zone-11330119-1-r3l22"/>mit pheilen.
          <lb facs="#zone-11330119-1-r3l23"/>Item fũnff alt kupffrine hantpũxen.
          <lb facs="#zone-11330119-1-r3l24"/>Item ain zũgsaill.
          <lb facs="#zone-11330119-1-r3l25"/>Item zechen new̃ armbrũst.
          <lb facs="#zone-11330119-1-r3l26"/>Item ain spanpangkh.
          <lb facs="#zone-11330119-1-r3l27"/>Item ain korenkast.
          <lb facs="#zone-11330119-1-r3l28"/>Item ain trŭch ze kãsen.
          <lb facs="#zone-11330119-1-r3l29"/>Item zwaỹ mesgwant mit der zũgehõr.
          <lb facs="#zone-11330119-1-r3l30"/>Item ain kupffrin kelch mit der paten.
          <lb facs="#zone-11330119-1-r3l31"/>Item ain silbrein vergũlter kelch.
          <lb facs="#zone-11330119-1-r3l32"/>Item vier alter tŭcher.
          <lb facs="#zone-11330119-1-r3l33"/>Item zweỹ õpferkãndel.
        </ab>
        <pb n="2" facs="#surface-11330119-2"/>
        <ab xml:id="ab-11330119-2-r1">
          <milestone unit="folio" n="1v"/>
        </ab>
        <ab xml:id="ab-11330119-2-r2">
          <lb facs="#zone-11330119-2-r2l1"/>Item ain mesbũch.
          <lb facs="#zone-11330119-2-r2l2"/>Item zwoe gesangpũchel.
          <lb facs="#zone-11330119-2-r2l3"/>Item ain klains pargameins psalterli.
          <lb facs="#zone-11330119-2-r2l4"/>Item ain altz gesangpũchel.
          <lb facs="#zone-11330119-2-r2l5"/>Item ain altz pargameins mespũchel.
          <lb facs="#zone-11330119-2-r2l6"/>Item mer etliche alte pũcher.
          <lb facs="#zone-11330119-2-r2l7"/>Item ain haŭßmũll mit aller zŭgehŏr.
        </ab>
        <ab xml:id="ab-11330119-2-r3">
          <lb facs="#zone-11330119-2-r3l1"/>Item beỹ allen vorgeschriben sachen
          <lb facs="#zone-11330119-2-r3l2"/>sind gwesen Hanns Paw̃r pergkhrichter
          <lb facs="#zone-11330119-2-r3l3"/>ze Umbst, Jos Hew̃gel gerichtschreiber
          <lb facs="#zone-11330119-2-r3l4"/>daselbs und Marx Erb wonhaft
          <lb facs="#zone-11330119-2-r3l5"/>ze Landegkh, verpetschaft durch
          <lb facs="#zone-11330119-2-r3l6"/>Cristan Fras richter ze Landegkh.
          <lb facs="#zone-11330119-2-r3l7"/>Actum an mitich nach Ambrosi
          <lb facs="#zone-11330119-2-r3l8"/>anno Domini etc. octũagesimosexto.
        </ab>
        <pb n="3" facs="#surface-11330119-3"/>
        <ab xml:id="ab-11330119-3-r1">
          <milestone unit="folio" n="2r"/>
        </ab>
        <pb n="4" facs="#surface-11330119-4"/>
        <ab xml:id="ab-11330119-4-r1">
          <lb facs="#zone-11330119-4-r1l1"/>Inventuari zedl gen Wysperg wie
          <lb facs="#zone-11330119-4-r1l2"/>dasselb sloss Anthonien Schencken
          <lb facs="#zone-11330119-4-r1l3"/>durch Hannsen Keren weylend Hannsen
          <lb facs="#zone-11330119-4-r1l4"/>Wysers verlassen erben gerhaben ist
          <lb facs="#zone-11330119-4-r1l5"/>eingeantwurt worden.
        </ab>
        <pb n="5" facs="#surface-11330119-5"/>
      </div>

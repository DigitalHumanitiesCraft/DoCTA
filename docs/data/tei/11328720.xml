        <ab xml:id="ab-11328720-1-r2">
          <lb facs="#zone-11328720-1-r2l1"/>Vermerckt die inventuari czettl des
          <lb facs="#zone-11328720-1-r2l2"/>hausplonder und massaria auff
          <lb facs="#zone-11328720-1-r2l3"/>Sigmunds Lust meinem gnãdigisten
          <lb facs="#zone-11328720-1-r2l4"/>herrenn czugehorendt so Sigmunden
          <lb facs="#zone-11328720-1-r2l5"/>Mãxelraỹner, pfleger ze Frũnttsperg
          <lb facs="#zone-11328720-1-r2l6"/>und Sigmunds Lust von Linhardt
          <lb facs="#zone-11328720-1-r2l7"/>Langseỹss geanttwurtt ist und hie
          <lb facs="#zone-11328720-1-r2l8"/>innen auff geschribenn in gegen¬
          <lb facs="#zone-11328720-1-r2l9"/>wũrtigkaitt und bey wesen der
          <lb facs="#zone-11328720-1-r2l10"/>erberen Ludwig Haugen und Clauss
          <lb facs="#zone-11328720-1-r2l11"/>Vingkh cze Swatz. Geschechen am
          <lb facs="#zone-11328720-1-r2l12"/>ertag nach Exalta(tio) Cruc(is) anno etc.
          <lb facs="#zone-11328720-1-r2l13"/>octuagesimo octavo.
        </ab>
        <ab xml:id="ab-11328720-1-r3">
          <lb facs="#zone-11328720-1-r3l1"/>Item in der kamer bey̑ der obrenn stuben.
        </ab>
        <ab xml:id="ab-11328720-1-r4">
          <lb facs="#zone-11328720-1-r4l1"/>VI par hărbin leỹlacher.
          <lb facs="#zone-11328720-1-r4l2"/>II tysch tuecher.
          <lb facs="#zone-11328720-1-r4l3"/>III umblegen oder hantt zwechel.
          <lb facs="#zone-11328720-1-r4l4"/>XI genãtt decklachenn.
          <lb facs="#zone-11328720-1-r4l5"/>I raỹsschwertt, I prattspỹss.
          <lb facs="#zone-11328720-1-r4l6"/>I stroe huett.
          <lb facs="#zone-11328720-1-r4l7"/>VIII bett, VIII põlster, IIII kw̃ss.
          <lb facs="#zone-11328720-1-r4l8"/>V stroeseckh.
          <lb facs="#zone-11328720-1-r4l9"/>I messynn kandell, I messynn peckh.
          <lb facs="#zone-11328720-1-r4l10"/>V messing law̃chter gross und klain.
          <lb facs="#zone-11328720-1-r4l11"/>III eysnynn uberzintt leũchter.
          <lb facs="#zone-11328720-1-r4l12"/>I czỹneỹn gỹesfass.
          <lb facs="#zone-11328720-1-r4l13"/>III saltz fãssell.
          <lb facs="#zone-11328720-1-r4l14"/>VIII pfannen klainer und grõsser,
          <lb facs="#zone-11328720-1-r4l15"/>guett und põser.
          <lb facs="#zone-11328720-1-r4l16"/>XV erdein hȃffenn klayn und gross.
          <lb facs="#zone-11328720-1-r4l17"/>VI haffenplattenn, I rybeysenn.
          <lb facs="#zone-11328720-1-r4l18"/>II hackh messer, II brattspyss.
          <lb facs="#zone-11328720-1-r4l19"/>I roscht, III fewrhuntt, I dryfuess.
          <lb facs="#zone-11328720-1-r4l20"/>II dryfuess czum bratten.
          <lb facs="#zone-11328720-1-r4l21"/>II mass kandel, I zwỹmassig kandel.
          <lb facs="#zone-11328720-1-r4l22"/>I hang(e)nd kandell, I drincken kăndell.
          <lb facs="#zone-11328720-1-r4l23"/>VIIII zinschũssell, I plan, IIII salsen schũssel.
        </ab>

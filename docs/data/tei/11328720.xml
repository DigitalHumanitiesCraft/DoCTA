        <ab xml:id="ab-11328720-2-r2">
          <lb facs="#zone-11328720-2-r2l1"/>Item II wein zefftenn, I kwbell.
          <lb facs="#zone-11328720-2-r2l2"/>VI wasser schãffer, I spuelschaff.
          <lb facs="#zone-11328720-2-r2l3"/>V kessell klainer und grõsser.
          <lb facs="#zone-11328720-2-r2l4"/>I mel trõgell, I melkũbl, I prottschaff.
          <lb facs="#zone-11328720-2-r2l5"/>VIII messing haggen pũxsenn.
          <lb facs="#zone-11328720-2-r2l6"/>IIII eysnyn haggen pũxsenn.
          <lb facs="#zone-11328720-2-r2l7"/>IIII messing hantt pũxsenn.
          <lb facs="#zone-11328720-2-r2l8"/>I vãssell mitt pulver.
          <lb facs="#zone-11328720-2-r2l9"/>I grosser hŭltzĭner weinkopff.
          <lb facs="#zone-11328720-2-r2l10"/>III schreib tysch, IIII schlecht týsch.
          <lb facs="#zone-11328720-2-r2l11"/>I credentz tysch.
          <lb facs="#zone-11328720-2-r2l12"/>I tyschell mitt ainem spilbrett.
          <lb facs="#zone-11328720-2-r2l13"/>III gross spanpett, II radelbett.
          <lb facs="#zone-11328720-2-r2l14"/>I fuestruchen, I czwifacher gwanttkast.
          <lb facs="#zone-11328720-2-r2l15"/>II truchen, I pett stuell.
          <lb facs="#zone-11328720-2-r2l16"/>V vorpenckh, III wein lãgell.
          <lb facs="#zone-11328720-2-r2l17"/>I essich vãssell.
        </ab>
        <ab xml:id="ab-11328720-2-r3">
          <lb facs="#zone-11328720-2-r3l1"/>Durchleuchtiger hochgeborner
          <lb facs="#zone-11328720-2-r3l2"/>furst gnådigister herr, ich
          <lb facs="#zone-11328720-2-r3l3"/>hab mich befragt und erkundt
          <lb facs="#zone-11328720-2-r3l4"/>und kãnn kain andre inventuari
          <lb facs="#zone-11328720-2-r3l5"/>zettell erfragen dann die mir
          <lb facs="#zone-11328720-2-r3l6"/>der Langseysen furbracht hatt
          <lb facs="#zone-11328720-2-r3l7"/>wie im die massaria und
          <lb facs="#zone-11328720-2-r3l8"/>ander von Ludwig Haugen
          <lb facs="#zone-11328720-2-r3l9"/>ein geanttwurtt und auff
          <lb facs="#zone-11328720-2-r3l10"/>geschriben sei, dabei Ludwig
          <lb facs="#zone-11328720-2-r3l11"/>Hawg ỹtzuntt auch gewesen
          <lb facs="#zone-11328720-2-r3l12"/>ist, der sagt im sei kain
          <lb facs="#zone-11328720-2-r3l13"/>gegen inventuari czettell ge¬
          <lb facs="#zone-11328720-2-r3l14"/>anttwurtt, aber er wiß kain
          <lb facs="#zone-11328720-2-r3l15"/>mangell der da sei wann
          <lb facs="#zone-11328720-2-r3l16"/>das es dem Langseysen also
          <lb facs="#zone-11328720-2-r3l17"/>geanttwurtt seȋ.
        </ab>

    <body>
      <div type="transcription">
        <pb n="1" facs="#surface-11329279-1"/>
        <ab xml:id="ab-11329279-1-r1">
          <milestone unit="folio" n="1r"/>
        </ab>
        <pb n="2" facs="#surface-11329279-2"/>
        <ab xml:id="ab-11329279-2-r1">
          <milestone unit="folio" n="1v"/>
        </ab>
        <ab xml:id="ab-11329279-2-r2">
          <lb facs="#zone-11329279-2-r2l1"/>It(em) in dem undtern staingaden
          <lb facs="#zone-11329279-2-r2l2"/>1/2 läg(e)l pfeil.
          <lb facs="#zone-11329279-2-r2l3"/>It(em) ain fueter kăstel im undt(er)n staing[---].
          <lb facs="#zone-11329279-2-r2l4"/>It(em) in meins h(er)ren stuben vier scht[---]
          <lb facs="#zone-11329279-2-r2l5"/>tisch, der viert in d(er) ander(e)n stubn.
          <lb facs="#zone-11329279-2-r2l6"/>It(e)m in dem ergkar gen d(er) Schãrnitz
          <lb facs="#zone-11329279-2-r2l7"/>ain tȃrispũchß(en).
          <lb facs="#zone-11329279-2-r2l8"/>It(em) in dem arckãr gen Seveld wertz
          <lb facs="#zone-11329279-2-r2l9"/>fúnff clotz(e)n puchsen.
          <lb facs="#zone-11329279-2-r2l10"/>It(em) mer daselbs III hagk(e)n püchsen
          <lb facs="#zone-11329279-2-r2l11"/>und ain claine pũchsen.
          <lb facs="#zone-11329279-2-r2l12"/>It(em) ain metz(e)n puxenpulver.
          <lb facs="#zone-11329279-2-r2l13"/>It(em) in d(er) kuchen ain alte speistruhen
          <lb facs="#zone-11329279-2-r2l14"/>und ain speis käst(e)l.
          <lb facs="#zone-11329279-2-r2l15"/>It(em) in dem hinter kraut keller ain
          <lb facs="#zone-11329279-2-r2l16"/>mȯrser.
          <lb facs="#zone-11329279-2-r2l17"/>It(em) alle pettstat new und alt
          <lb facs="#zone-11329279-2-r2l18"/>nach ausfart des Clam(m)ers
          <lb facs="#zone-11329279-2-r2l19"/>sind alle der Burckhartin von
          <lb facs="#zone-11329279-2-r2l20"/>Hausen, hat sÿ im gschloß
          <lb facs="#zone-11329279-2-r2l21"/>gelassen wer ir das bezalt.
          <lb facs="#zone-11329279-2-r2l22"/>It(em) ain eÿsne häl ob dem herd
          <lb facs="#zone-11329279-2-r2l23"/>ist auch der Purckhartin vo(n)
          <lb facs="#zone-11329279-2-r2l24"/>Hausen.
        </ab>
        <pb n="3" facs="#surface-11329279-3"/>
        <ab xml:id="ab-11329279-3-r1">
          <milestone unit="folio" n="2r"/>
        </ab>
        <pb n="4" facs="#surface-11329279-4"/>
        <ab xml:id="ab-11329279-4-r1">
          <milestone unit="folio" n="2v"/>
        </ab>
        <ab xml:id="ab-11329279-4-r2">
          <lb facs="#zone-11329279-4-r2l1"/>Inventari was Pangracz(e)n
          <lb facs="#zone-11329279-4-r2l2"/>Hanen auf Slosperg
          <lb facs="#zone-11329279-4-r2l3"/>ingeantwurt ist.
        </ab>
      </div>
    </body>

        <ab xml:id="ab-11329462-1-r2">
          <lb facs="#zone-11329462-1-r2l1"/>Vermerckt den gezŭg so juncker
          <lb facs="#zone-11329462-1-r2l2"/>Cristoff Rentlÿ juncker Josseppen
          <lb facs="#zone-11329462-1-r2l3"/>U̇berriner in geantwurt haut zů
          <lb facs="#zone-11329462-1-r2l4"/>Sigmundsegg am mitwochen an
          <lb facs="#zone-11329462-1-r2l5"/>dem Cotember in der Vasten im LXXXV.
        </ab>
        <ab xml:id="ab-11329462-1-r3">
          <lb facs="#zone-11329462-1-r3l1"/>Item vier möschÿ hagenbu̇chssen.
          <lb facs="#zone-11329462-1-r3l2"/>Sechs hantbu̇chssen.
          <lb facs="#zone-11329462-1-r3l3"/>Ain halbs väsly mit pulffer.
          <lb facs="#zone-11329462-1-r3l4"/>Sechs armbrust.
          <lb facs="#zone-11329462-1-r3l5"/>Drÿ winden.
          <lb facs="#zone-11329462-1-r3l6"/>Ain lagil mit pfilen.
          <lb facs="#zone-11329462-1-r3l7"/>Ain schafrait.
          <lb facs="#zone-11329462-1-r3l8"/>Ain betstat.
          <lb facs="#zone-11329462-1-r3l9"/>Zwo pfannen.
          <lb facs="#zone-11329462-1-r3l10"/>Zwo rotschu̇schlen.
          <lb facs="#zone-11329462-1-r3l11"/>Ain lang schwert.
          <lb facs="#zone-11329462-1-r3l12"/>Ain gros horn.
          <lb facs="#zone-11329462-1-r3l13"/>Ain stuck blÿ.
          <lb facs="#zone-11329462-1-r3l14"/>Ain lang zugsail.
          <lb facs="#zone-11329462-1-r3l15"/>Ain spis truchen.
          <lb facs="#zone-11329462-1-r3l16"/>Ain vancknus ÿsen.
          <lb facs="#zone-11329462-1-r3l17"/>Zwo seges sen.
          <lb facs="#zone-11329462-1-r3l18"/>Ain häll.
          <lb facs="#zone-11329462-1-r3l19"/>Ain rost.
          <lb facs="#zone-11329462-1-r3l20"/>Ain drÿfůs.
          <lb facs="#zone-11329462-1-r3l21"/>Item Leo Schmid zů Pfuns ist schuldig
          <lb facs="#zone-11329462-1-r3l22"/>m(einem) g(nädigen) h(erren) drÿ eÿssenplech, zwaÿ
          <lb facs="#zone-11329462-1-r3l23"/>wagen reder kosten XXVI gl. sol
          <lb facs="#zone-11329462-1-r3l24"/>er weschlachen, haut dar an hin
          <lb facs="#zone-11329462-1-r3l25"/>ain r(einischer) gulden ist verrait m(einem) g(nädigen) h(erren).
          <lb facs="#zone-11329462-1-r3l26"/>Drÿ hu̇bsch strithacken.
          <lb facs="#zone-11329462-1-r3l27"/>Zwen schwin spies.
          <lb facs="#zone-11329462-1-r3l28"/>Ain eren spies mit aim schwȃrtzen schaft.
          <lb facs="#zone-11329462-1-r3l29"/>Vier märter howen.
          <lb facs="#zone-11329462-1-r3l30"/>Drÿ bickel.
          <lb facs="#zone-11329462-1-r3l31"/>Vier eẏssen schuflen.
          <lb facs="#zone-11329462-1-r3l32"/>Zwo holtz hacken.
          <lb facs="#zone-11329462-1-r3l33"/>Ain piel.
          <lb facs="#zone-11329462-1-r3l34"/>Neúw eẏssenplech.
          <lb facs="#zone-11329462-1-r3l35"/>Vier lad eÿssen.
        </ab>

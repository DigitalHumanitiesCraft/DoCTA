  <text xml:lang="gmh">
    <body>
      <div type="transcription">
        <pb n="1" facs="#surface-11328279-1"/>
        <ab xml:id="ab-11328279-1-r1">
          <milestone unit="folio" n="1r"/>
        </ab>
        <ab xml:id="ab-11328279-1-r2">
          <lb facs="#zone-11328279-1-r2l1"/>Vermerckt die hab und guĕt so
          <lb facs="#zone-11328279-1-r2l2"/>herr Melchior von Heymenhofen
          <lb facs="#zone-11328279-1-r2l3"/>als er ab der phleg Thaur gezogen
          <lb facs="#zone-11328279-1-r2l4"/>ist, herren Jacoben von Spaur ze
          <lb facs="#zone-11328279-1-r2l5"/>kauffen geben hat und ist also
          <lb facs="#zone-11328279-1-r2l6"/>betewrt und angeslagen.
        </ab>
        <ab xml:id="ab-11328279-1-r3">
          <lb facs="#zone-11328279-1-r3l1"/>Von erst etlichs hew̆, davon sol ain
          <lb facs="#zone-11328279-1-r3l2"/>fuederle mit zwain rossen gefuĕrt
          <lb facs="#zone-11328279-1-r3l3"/>werden, und etlich stro pro
          <lb facs="#zone-11328279-1-r3l4"/>XXIIII gld.
          <lb facs="#zone-11328279-1-r3l5"/>XXXIIII stăr koren und 1/2 stăr ist
          <lb facs="#zone-11328279-1-r3l6"/>darein gelassen, ain star pro I lb.,
          <lb facs="#zone-11328279-1-r3l7"/>facit
          <lb facs="#zone-11328279-1-r3l8"/>III mr̃. IIII lb.
          <lb facs="#zone-11328279-1-r3l9"/>XLVI stăr gersten, I stăr pro X k.,
          <lb facs="#zone-11328279-1-r3l10"/>facit
          <lb facs="#zone-11328279-1-r3l11"/>III mr̃. VIII lb. IIII k.
          <lb facs="#zone-11328279-1-r3l12"/>Zwo groß swăbisch kandeln.
          <lb facs="#zone-11328279-1-r3l13"/>Ain zwo måssige kandel, drey maß
          <lb facs="#zone-11328279-1-r3l14"/>kandl, ain trinckn kandel, drey
          <lb facs="#zone-11328279-1-r3l15"/>zynein schŭseln, ain saltzfas, ain
          <lb facs="#zone-11328279-1-r3l16"/>gyesfas. Ist alles geschătzt pro
          <lb facs="#zone-11328279-1-r3l17"/>X lb.
          <lb facs="#zone-11328279-1-r3l18"/>VII pfannen klein und groß
          <lb facs="#zone-11328279-1-r3l19"/>und ain pfefferpfannen pro
          <lb facs="#zone-11328279-1-r3l20"/>III lb.
          <lb facs="#zone-11328279-1-r3l21"/>XXIIII kŏtin hăfen klein und groß
          <lb facs="#zone-11328279-1-r3l22"/>pro II lb. VI k.
        </ab>
        <pb n="2" facs="#surface-11328279-2"/>
        <ab xml:id="ab-11328279-2-r1">
          <milestone unit="folio" n="1v"/>
        </ab>
        <ab xml:id="ab-11328279-2-r2">
          <lb facs="#zone-11328279-2-r2l1"/>Drey kessl klein und groß und
          <lb facs="#zone-11328279-2-r2l2"/>ain rebeysen pro VII lb.
          <lb facs="#zone-11328279-2-r2l3"/>Ain rost, alte hackmesser, ain kuechl
          <lb facs="#zone-11328279-2-r2l4"/>spiß, ain pawmschab, ain hafendeck
          <lb facs="#zone-11328279-2-r2l5"/>pro II lb.
          <lb facs="#zone-11328279-2-r2l6"/>Etlich milich năpf, schŭsseln,
          <lb facs="#zone-11328279-2-r2l7"/>tăller, zway slegkubel, zwen
          <lb facs="#zone-11328279-2-r2l8"/>smaltzkubel und etliche schăffer pro
          <lb facs="#zone-11328279-2-r2l9"/>I gld.
          <lb facs="#zone-11328279-2-r2l10"/>Zwen padzuber und ain sechteren
          <lb facs="#zone-11328279-2-r2l11"/>pro IIII lb.
          <lb facs="#zone-11328279-2-r2l12"/>Ain grosse vischpfannen und
          <lb facs="#zone-11328279-2-r2l13"/>ain nudlpfannen pro II lb.
          <lb facs="#zone-11328279-2-r2l14"/>Ain speiskasten in der kuchen pro
          <lb facs="#zone-11328279-2-r2l15"/>IIII lb.
          <lb facs="#zone-11328279-2-r2l16"/>Ain harnaschkasten und ain
          <lb facs="#zone-11328279-2-r2l17"/>gutschenspanpet mit ainem
          <lb facs="#zone-11328279-2-r2l18"/>himel in der stuben pro VI lb.
          <lb facs="#zone-11328279-2-r2l19"/>Zwo sidltruhen und ain kastel
          <lb facs="#zone-11328279-2-r2l20"/>zů ainem gyesfas in der stuben
          <lb facs="#zone-11328279-2-r2l21"/>hat er im darein gelassen.
        </ab>
        <pb n="3" facs="#surface-11328279-3"/>
        <ab xml:id="ab-11328279-3-r1">
          <lb facs="#zone-11328279-3-r1l1"/>Item auf Tawr hat das groser vas
          <lb facs="#zone-11328279-3-r1l2"/>zehen ürn, dar an get ab dreÿ pazeiden
          <lb facs="#zone-11328279-3-r1l3"/>und das chlainer vas hat dreÿ urn
          <lb facs="#zone-11328279-3-r1l4"/>daran get ab ain pazeiden.
        </ab>
        <pb n="4" facs="#surface-11328279-4"/>
        <ab xml:id="ab-11328279-4-r1">
          <lb facs="#zone-11328279-4-r1l1"/>Etschwein X urn minus III pazeiden, I urn pro XI
          <lb facs="#zone-11328279-4-r1l2"/>lb., facit XI mr̃. Daran gend die III pazeiden
          <lb facs="#zone-11328279-4-r1l3"/>herab.
        </ab>
        <pb n="5" facs="#surface-11328279-5"/>
        <ab xml:id="ab-11328279-5-r1">
          <milestone unit="folio" n="2r"/>
        </ab>
        <ab xml:id="ab-11328279-5-r2">
          <lb facs="#zone-11328279-5-r2l1"/>Zehen swein klein und groß
          <lb facs="#zone-11328279-5-r2l2"/>pro V gld. II lb.
          <lb facs="#zone-11328279-5-r2l3"/>Zwen wăgen, ain pflueg
          <lb facs="#zone-11328279-5-r2l4"/>mit iren zugehorungen pro
          <lb facs="#zone-11328279-5-r2l5"/>VI gld.
          <lb facs="#zone-11328279-5-r2l6"/>Ain karr pro III lb.
          <lb facs="#zone-11328279-5-r2l7"/>Ain vaß swabisch wein, I uren
          <lb facs="#zone-11328279-5-r2l8"/>pro VIII lb., sol das vaß gefisert
          <lb facs="#zone-11328279-5-r2l9"/>und darnach was das bringt
          <lb facs="#zone-11328279-5-r2l10"/>bezalt werden und hat innen
          <lb facs="#zone-11328279-5-r2l11"/>III uren minus I paceiden.
          <lb facs="#zone-11328279-5-r2l12"/>Ain vaß etschwein, sol auch
          <lb facs="#zone-11328279-5-r2l13"/>gefisert und was das bringt
          <lb facs="#zone-11328279-5-r2l14"/>albeg ain uren pro XI lb. bezalt
          <lb facs="#zone-11328279-5-r2l15"/>werden und hat innen X uren
          <lb facs="#zone-11328279-5-r2l16"/>minus III paceiden.
        </ab>
        <pb n="6" facs="#surface-11328279-6"/>
        <ab xml:id="ab-11328279-6-r1">
          <milestone unit="folio" n="2v"/>
        </ab>
        <pb n="7" facs="#surface-11328279-7"/>
        <ab xml:id="ab-11328279-7-r1">
          <milestone unit="folio" n="3r"/>
        </ab>
        <pb n="8" facs="#surface-11328279-8"/>
        <ab xml:id="ab-11328279-8-r1">
          <milestone unit="folio" n="3v"/>
        </ab>
        <pb n="9" facs="#surface-11328279-9"/>
        <ab xml:id="ab-11328279-9-r1">
          <milestone unit="folio" n="4r"/>
        </ab>
        <pb n="10" facs="#surface-11328279-10"/>
        <ab xml:id="ab-11328279-10-r1">
          <milestone unit="folio" n="4v"/>
        </ab>
      </div>

  <text xml:lang="gmh">
    <body>
      <div type="transcription">
        <pb n="1" facs="#surface-11329621-1"/>
        <ab xml:id="ab-11329621-1-r1">
          <milestone unit="folio" n="1r"/>
        </ab>
        <ab xml:id="ab-11329621-1-r2">
          <lb facs="#zone-11329621-1-r2l1"/>Inventuary̆ zedl von jŭnckherr
          <lb facs="#zone-11329621-1-r2l2"/>Joseppen Ŭberrein Cristoffen Răntly̆
          <lb facs="#zone-11329621-1-r2l3"/>in geantwort am erchtag vor
          <lb facs="#zone-11329621-1-r2l4"/>Margarete anno etc. octuagesimo nono.
        </ab>
        <ab xml:id="ab-11329621-1-r3">
          <lb facs="#zone-11329621-1-r3l1"/>Item vier mĕsseny̆ haggen pŭxen.
          <lb facs="#zone-11329621-1-r3l2"/>Item sex hanndt püxen.
          <lb facs="#zone-11329621-1-r3l3"/>Item sex arembrust.
          <lb facs="#zone-11329621-1-r3l4"/>Item drey̆ winden.
          <lb facs="#zone-11329621-1-r3l5"/>Item ain schaffrait und ain pĕttstat.
          <lb facs="#zone-11329621-1-r3l6"/>Item zwŏ pfannen.
          <lb facs="#zone-11329621-1-r3l7"/>Item zwŏ röt schŭssl.
          <lb facs="#zone-11329621-1-r3l8"/>Item ain lanngs schwĕrtt.
          <lb facs="#zone-11329621-1-r3l9"/>Item ain gross horen.
          <lb facs="#zone-11329621-1-r3l10"/>Item ain stuckh pley̆.
          <lb facs="#zone-11329621-1-r3l11"/>Item ain lanngs zug say̆l.
          <lb facs="#zone-11329621-1-r3l12"/>Item ain speiß truchen.
          <lb facs="#zone-11329621-1-r3l13"/>Item ain fănncknũss eÿsen.
          <lb facs="#zone-11329621-1-r3l14"/>Item zwŏ segensen.
          <lb facs="#zone-11329621-1-r3l15"/>Item ain häl, ein roest und ain dry̆fuess.
          <lb facs="#zone-11329621-1-r3l16"/>Item Leo Schmid von Pfŭnss ist schuldig
          <lb facs="#zone-11329621-1-r3l17"/>meinem gnädigen herren drew eỹsnplĕch und zway̆
          <lb facs="#zone-11329621-1-r3l18"/>wagen rĕder, costent XXVI gl., dỹ solt
          <lb facs="#zone-11329621-1-r3l19"/>er beschlagen.
          <lb facs="#zone-11329621-1-r3l20"/>Dar an hat er h[...] I R(heinischen) gulden der ist
          <lb facs="#zone-11329621-1-r3l21"/>verrait meinem gnädigen herren.
        </ab>
        <pb n="2" facs="#surface-11329621-2"/>
        <ab xml:id="ab-11329621-2-r1">
          <milestone unit="folio" n="1v"/>
        </ab>
        <ab xml:id="ab-11329621-2-r2">
          <lb facs="#zone-11329621-2-r2l1"/>Item zwŏ streithacken, dy̆ dritt ist erprochen.
          <lb facs="#zone-11329621-2-r2l2"/>Item zwen schweinspiess.
          <lb facs="#zone-11329621-2-r2l3"/>Item ain oeraten spiess mit aim swartzen schafft.
          <lb facs="#zone-11329621-2-r2l4"/>Item vier mŏrter haw̃en.
          <lb facs="#zone-11329621-2-r2l5"/>Item dreÿ pickl.
          <lb facs="#zone-11329621-2-r2l6"/>Item vier eỹsnschawfl.
          <lb facs="#zone-11329621-2-r2l7"/>Item zwŏ holtz hacken und ain pew̆l.
          <lb facs="#zone-11329621-2-r2l8"/>Item new̆n ey̆senplĕch.
          <lb facs="#zone-11329621-2-r2l9"/>Item vier ladeÿsen.
          <lb facs="#zone-11329621-2-r2l10"/>Item ain glŏgkel da sol man ane maid
          <lb facs="#zone-11329621-2-r2l11"/>dar mit leẅtten hat m(ein) g(nediger) herr dar geben.
          <lb facs="#zone-11329621-2-r2l12"/>Item zwo ey̆sne zug scheÿben und ain ey̆sne zug scheÿben und ain ey̆sener
          <lb facs="#zone-11329621-2-r2l13"/>nagl gehŏrt dar durch.
          <lb facs="#zone-11329621-2-r2l14"/>Item siben pĕttstatten.
          <lb facs="#zone-11329621-2-r2l15"/>Item ain truchen mit ainm schloss.
          <lb facs="#zone-11329621-2-r2l16"/>Item vier eÿsene lÿder so man tŭrn da
          <lb facs="#zone-11329621-2-r2l17"/>mit an henngt.
        </ab>
        <ab xml:id="ab-11329621-2-r3">
          <lb facs="#zone-11329621-2-r3l1"/>Ingegenwürtikait sind dar mit und da
          <lb facs="#zone-11329621-2-r3l2"/>pey̆ gewesen Hanns von Newenhauwss
          <lb facs="#zone-11329621-2-r3l3"/>pfleger auf Naudersperg, Josep Kŭntz Schlüchter
          <lb facs="#zone-11329621-2-r3l4"/>als richter zŭ Nauders, Josep Rosennpach,
          <lb facs="#zone-11329621-2-r3l5"/>Jacob Mitterhofer auch von Nauders,
          <lb facs="#zone-11329621-2-r3l6"/>Peter Pfanholtz richter zŭ Pfŭnss, Kŭnrad
          <lb facs="#zone-11329621-2-r3l7"/>Mĕtz, Hanns Utzenfeld auch von Pfŭnss
          <lb facs="#zone-11329621-2-r3l8"/>ŭnd mer erbar lew̆tt.
        </ab>
        <pb n="3" facs="#surface-11329621-3"/>

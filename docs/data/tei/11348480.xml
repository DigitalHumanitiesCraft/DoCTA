        <ab xml:id="ab-11348480-1-r2">
          <lb facs="#zone-11348480-1-r2l1"/>Nota vermerkcht die varende
          <lb facs="#zone-11348480-1-r2l2"/>hab die mir der Valentein
          <lb facs="#zone-11348480-1-r2l3"/>von Montãny auff Lichten¬
          <lb facs="#zone-11348480-1-r2l4"/>bergk geantwũrtet hat als
          <lb facs="#zone-11348480-1-r2l5"/>er mir Lichtenberg hat uber¬
          <lb facs="#zone-11348480-1-r2l6"/>geben und ich ingenomenn
          <lb facs="#zone-11348480-1-r2l7"/>hab ingegenwirtikaÿt der
          <lb facs="#zone-11348480-1-r2l8"/>erbern lew̆t die her nach
          <lb facs="#zone-11348480-1-r2l9"/>geschribenn stendt etc.
        </ab>
        <ab xml:id="ab-11348480-1-r3">
          <lb facs="#zone-11348480-1-r3l1"/>Item am ersten ain eysnene pũchss
          <lb facs="#zone-11348480-1-r3l2"/>die schŭst ain stain als gross als
          <lb facs="#zone-11348480-1-r3l3"/>ain klaine veltkŭegel.
          <lb facs="#zone-11348480-1-r3l4"/>Item und zwaÿ pfund púchsen pũlver.
          <lb facs="#zone-11348480-1-r3l5"/>Item und XXXX hauss pfey̆ll.
          <lb facs="#zone-11348480-1-r3l6"/>Item ain tisch in der stũebenn.
          <lb facs="#zone-11348480-1-r3l7"/>Item dreÿ new schintlein kästen die
          <lb facs="#zone-11348480-1-r3l8"/>hat der Peter Kobolt die zwen
          <lb facs="#zone-11348480-1-r3l9"/>gen Malls gefŭrt an mein
          <lb facs="#zone-11348480-1-r3l10"/>willen und wissen und sprach
          <lb facs="#zone-11348480-1-r3l11"/>er wolts zú dem turen und
          <lb facs="#zone-11348480-1-r3l12"/>mein hern der hauptman und
          <lb facs="#zone-11348480-1-r3l13"/>mein hern her Wigloys hettens mit
          <lb facs="#zone-11348480-1-r3l14"/>im geschaffenn.
          <lb facs="#zone-11348480-1-r3l15"/>Item zwën fleỹsch stokch.
          <lb facs="#zone-11348480-1-r3l16"/>Item zwaÿ halbvass.
          <lb facs="#zone-11348480-1-r3l17"/>Item ain newe hërdt.
          <lb facs="#zone-11348480-1-r3l18"/>Item ain hŭndert new̑ schintlen.
          <lb facs="#zone-11348480-1-r3l19"/>Item VI fŭrpẽnkch.
          <lb facs="#zone-11348480-1-r3l20"/>Item ain knẽttrog.
          <lb facs="#zone-11348480-1-r3l21"/>Item ain wũrchtavel zü dem prot.
        </ab>
        <pb n="2" facs="#surface-11348480-2"/>
        <ab xml:id="ab-11348480-2-r1">
          <milestone unit="folio" n="1v"/>
        </ab>
        <ab xml:id="ab-11348480-2-r2">
          <lb facs="#zone-11348480-2-r2l1"/>Item fier protprëtter.
          <lb facs="#zone-11348480-2-r2l2"/>Item zwwo leỹtter und ain leẏn.
          <lb facs="#zone-11348480-2-r2l3"/>Item ain wasser zuber inder küchenn.
          <lb facs="#zone-11348480-2-r2l4"/>Item ain richtavel inder kũchenn.
          <lb facs="#zone-11348480-2-r2l5"/>Item dreÿ new kas stelenn.
          <lb facs="#zone-11348480-2-r2l6"/>Item und wol peÿ X gewant stangen.
          <lb facs="#zone-11348480-2-r2l7"/>Item ain vass in dem tawlen tũren.
        </ab>
        <ab xml:id="ab-11348480-2-r3">
          <lb facs="#zone-11348480-2-r3l1"/>Item und peÿ der antwúrtung ist
          <lb facs="#zone-11348480-2-r3l2"/>gewësen auff Liechtenberg Felix
          <lb facs="#zone-11348480-2-r3l3"/>Ratgeb, Peter Kobolt die zeÿt
          <lb facs="#zone-11348480-2-r3l4"/>richter zü Glũrns, Asim von
          <lb facs="#zone-11348480-2-r3l5"/>Steten pfleger auff Kastelbeld,
          <lb facs="#zone-11348480-2-r3l6"/>Hanns Harem von Schanzenn,
          <lb facs="#zone-11348480-2-r3l7"/>Jöst Wirt von Tärss und Peter
          <lb facs="#zone-11348480-2-r3l8"/>Laymershofer von Slannderss
          <lb facs="#zone-11348480-2-r3l9"/>und ander lawt mer vonn
          <lb facs="#zone-11348480-2-r3l10"/>Lichtenbergk genŭg etc.
        </ab>

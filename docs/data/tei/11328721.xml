  <text xml:lang="gmh">
    <body>
      <div type="transcription">
        <pb n="1" facs="#surface-11328721-1"/>
        <ab xml:id="ab-11328721-1-r1">
          <milestone unit="folio" n="1r"/>
        </ab>
        <ab xml:id="ab-11328721-1-r2">
          <lb facs="#zone-11328721-1-r2l1"/>Ingegenwurtigkait m(eines) g(nedigen) h(errn)
          <lb facs="#zone-11328721-1-r2l2"/>he(rr)n Ludwigen von Masminster
          <lb facs="#zone-11328721-1-r2l3"/>hofmarschalck, Walth(er)en von
          <lb facs="#zone-11328721-1-r2l4"/>Stadion seiner gnaden rate, Stef¬
          <lb facs="#zone-11328721-1-r2l5"/>fan Harder forstmaister, Heurling
          <lb facs="#zone-11328721-1-r2l6"/>seiner g(naden) thurhŭtter, Conraden
          <lb facs="#zone-11328721-1-r2l7"/>Metzner und Hannsen Liechten¬
          <lb facs="#zone-11328721-1-r2l8"/>staren canczlschreiber, ist Got¬
          <lb facs="#zone-11328721-1-r2l9"/>hardten seiner gnaden ka¬
          <lb facs="#zone-11328721-1-r2l10"/>merknecht das sloss Fragen¬
          <lb facs="#zone-11328721-1-r2l11"/>stain mit aller seiner zůgeho¬
          <lb facs="#zone-11328721-1-r2l12"/>rung enngeben worden an
          <lb facs="#zone-11328721-1-r2l13"/>phincztag vor Anthoni anno
          <lb facs="#zone-11328721-1-r2l14"/>etc. LXX octavo.
          <lb facs="#zone-11328721-1-r2l15"/>Und ist dise massarey in de(m)
          <lb facs="#zone-11328721-1-r2l16"/>sloss als hernach stet funden
          <lb facs="#zone-11328721-1-r2l17"/>worden.
        </ab>
        <ab xml:id="ab-11328721-1-r3">
          <lb facs="#zone-11328721-1-r3l1"/>Item hanntpuchsen IIII.
          <lb facs="#zone-11328721-1-r3l2"/>Hackenpuchensen gross IIII.
          <lb facs="#zone-11328721-1-r3l3"/>Hackenpuchsen klain XXIII.
          <lb facs="#zone-11328721-1-r3l4"/>Karrenpuchsen IIII.
          <lb facs="#zone-11328721-1-r3l5"/>Und ain klain stainpuchsen.
          <lb facs="#zone-11328721-1-r3l6"/>Und ain grosse puchsen.
          <lb facs="#zone-11328721-1-r3l7"/>I1/2 vaslein mit pulver.
          <lb facs="#zone-11328721-1-r3l8"/>I1/2 lagl mit pheyl.
        </ab>
        <pb n="2" facs="#surface-11328721-2"/>
        <ab xml:id="ab-11328721-2-r1">
          <milestone unit="folio" n="1v"/>
        </ab>
        <ab xml:id="ab-11328721-2-r2">
          <lb facs="#zone-11328721-2-r2l1"/>Zwo pulver taschen.
          <lb facs="#zone-11328721-2-r2l2"/>II alte armst.
          <lb facs="#zone-11328721-2-r2l3"/>V pley platten.
          <lb facs="#zone-11328721-2-r2l4"/>Ain pŭchsen model
          <lb facs="#zone-11328721-2-r2l5"/>zŭ puchsen.
          <lb facs="#zone-11328721-2-r2l6"/>Ain hehel in der kuchen.
          <lb facs="#zone-11328721-2-r2l7"/>Ain kessel in der padstŭben.
          <lb facs="#zone-11328721-2-r2l8"/>I alte schilt tartschen.
          <lb facs="#zone-11328721-2-r2l9"/>Zwo karren puchsen auf
          <lb facs="#zone-11328721-2-r2l10"/>der wȇre.
          <lb facs="#zone-11328721-2-r2l11"/>Ain tafel auf de(m) altar
          <lb facs="#zone-11328721-2-r2l12"/>mit dem XII poten.
          <lb facs="#zone-11328721-2-r2l13"/>Ain silbrein kelch ŭbergũlt.
          <lb facs="#zone-11328721-2-r2l14"/>Ain stifftbrief.
          <lb facs="#zone-11328721-2-r2l15"/>Ain ornat mit seiner
          <lb facs="#zone-11328721-2-r2l16"/>zŭgehoru̇ng.
          <lb facs="#zone-11328721-2-r2l17"/>Ain spetial.
        </ab>
        <pb n="3" facs="#surface-11328721-3"/>
        <ab xml:id="ab-11328721-3-r1">
          <milestone unit="folio" n="2r"/>
        </ab>
        <ab xml:id="ab-11328721-3-r2">
          <lb facs="#zone-11328721-3-r2l1"/>Ain glocken.
          <lb facs="#zone-11328721-3-r2l2"/>Und I klaine darŭnder.
        </ab>
        <ab xml:id="ab-11328721-3-r3">
          <lb facs="#zone-11328721-3-r3l1"/>Der zetel sind zwo gleich
          <lb facs="#zone-11328721-3-r3l2"/>in ainem laut, hat gethan
          <lb facs="#zone-11328721-3-r3l3"/>aine und m(eines) g(nedigen) h(errn) cancz¬
          <lb facs="#zone-11328721-3-r3l4"/>ley aine die ander.
        </ab>
        <pb n="4" facs="#surface-11328721-4"/>
        <ab xml:id="ab-11328721-4-r1">
          <milestone unit="folio" n="2v"/>
        </ab>
        <ab xml:id="ab-11328721-4-r2">
          <lb facs="#zone-11328721-4-r2l1"/>Inventari auf Fragenstain
          <lb facs="#zone-11328721-4-r2l2"/>als das Gotharten Hartlieb
          <lb facs="#zone-11328721-4-r2l3"/>vom nach dem Hannsen
          <lb facs="#zone-11328721-4-r2l4"/>Lanngen ynngeantwurt ist.
        </ab>
      </div>
